{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "POS Minimarket",
  "version": "0.5.1",
  "identifier": "com.minimarket.pos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "POS Minimarket",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0QThGMEMwMUQzQ0E0OEIKUldTTHBEd2R3UENvWkF4aUxIc3dJQzVTWmNKZFoyNlVoNHpWUE1QbjBWeHYxMEJzejRDM0p4ZlUK",
      "endpoints": [
        "https://github.com/carlossgomz/pos-minimarket/releases/latest/download/latest.json"
      ]
    }
  }
}
