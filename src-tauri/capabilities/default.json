{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos por defecto de la ventana principal",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    "process:default",
    "allow-db-select",
    "allow-db-select-cache",
    "allow-db-execute",
    "allow-tiene-config-sync",
    "allow-guardar-config-sync",
    "allow-estado-conexion",
    "allow-escanear-factura",
    "allow-confirmar-venta",
    "allow-editar-venta-items",
    "allow-eliminar-venta",
    "allow-ajustar-stock",
    "allow-registrar-abono-cliente",
    "allow-registrar-abono-cliente-total",
    "allow-registrar-pago-proveedor",
    "allow-ajustar-factura-compra",
    "allow-registrar-consumo-interno",
    "allow-guardar-factura-compra",
    "allow-editar-factura-compra",
    "allow-eliminar-factura-compra",
    "allow-desglosar-producto",
    "allow-sincronizar-catalogo-delivery",
    "allow-obtener-pedidos-delivery-pendientes",
    "shell:allow-open"
  ]
}
